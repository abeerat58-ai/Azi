  hovertemplate:'%{x}<br>%{y:.1f}%<extra></extra>'
}], {...baseLayout, yaxis:{range:[0,100],ticksuffix:'%',gridcolor:'#E8F0EE'}, xaxis:{tickfont:{size:14}}, showlegend:false}, cfg);


Plotly.newPlot('trendChart', [
{
  type:'indicator',
  mode:'gauge+number+delta',
  value: DATA.overall.term2,
  delta:{
    reference: DATA.overall.term1,
    relative:false,
    valueformat:'.1f'
  },
  number:{
    suffix:'%',
    font:{size:42,color:'#006B5E',family:'Cairo'}
  },
  title:{
    text:'مستوى الرضا الحالي',
    font:{size:20,color:'#073B4C',family:'Cairo'}
  },
  gauge:{
    axis:{range:[0,100],tickwidth:1,tickcolor:'#073B4C'},
    bar:{color:'#00A878'},
    bgcolor:'#F3F8F7',
    borderwidth:2,
    bordercolor:'#DDE8E6',
    steps:[
      {range:[0,40], color:'#FDECEC'},
      {range:[40,70], color:'#FFF6E2'},
      {range:[70,100], color:'#E8F7F1'}
    ],
    threshold:{
      line:{color:'#D62828', width:4},
      thickness:0.75,
      value: DATA.overall.term1
    }
  },
  domain:{x:[0,1],y:[0,1]}
}
], {
  ...baseLayout,
  height:430,
  margin:{t:40,r:30,b:20,l:30},
  annotations:[
    {
      x:0.5,y:-0.04,xref:'paper',yref:'paper',
      text:'بداية العام: <b>'+pct(DATA.overall.term1)+'</b> &nbsp;&nbsp; | &nbsp;&nbsp; نهاية العام: <b>'+pct(DATA.overall.term2)+'</b><br>التحسن العام: <b style="color:#00A878">'+pp(DATA.overall.delta)+'</b>',
      showarrow:false,
      font:{family:'Cairo',size:15,color:'#073B4C'},
      align:'center'
    }
  ]
}, cfg);

const axes
 = DATA.axes.slice().sort((a,b)=>a.delta-b.delta);
Plotly.newPlot('axisChart', [
  {type:'bar', orientation:'h', name:'الفصل الأول', y:axes.map(x=>x.axis), x:axes.map(x=>x.term1), marker:{color:'#1C78A8'}, text:axes.map(x=>pct(x.term1)), textposition:'auto'},
  {type:'bar', orientation:'h', name:'الفصل الثاني', y:axes.map(x=>x.axis), x:axes.map(x=>x.term2), marker:{color:'#00A19A'}, text:axes.map(x=>pct(x.term2)), textposition:'auto'},
  {type:'scatter', mode:'markers+text', name:'التحسن', y:axes.map(x=>x.axis), x:axes.map(x=>Math.max(x.term1||0,x.term2||0)+14), text:axes.map(x=>pp(x.delta)), textfont:{color:axes.map(x=>x.delta>=0?'#00A878':'#D62828'), family:'Cairo', size:13}, marker:{size:2,color:'rgba(0,0,0,0)'}, hoverinfo:'skip'}
], {...baseLayout, height:460, barmode:'group', margin:{t:25,r:130,b:45,l:360}, xaxis:{range:[0,115],ticksuffix:'%',gridcolor:'#E8F0EE'}, yaxis:{automargin:true}, legend:{orientation:'h',x:.02,y:1.12}}, cfg);

const qs = DATA.comparison
.filter(x=>x.delta!==null && !x.question.includes("هل تم تجهيز المقصف عن طريق المتعهد مثل (الأجهزة الكهربائية والطاولات ... )"))
.sort((a,b)=>a.delta-b.delta);
Plotly.newPlot('questionChart', [{
  type:'bar', orientation:'h', y:qs.map(x=>String(x.id).padStart(2,'0')+' - '+x.short), x:qs.map(x=>x.delta),
  marker:{color:qs.map(x=>x.delta>=0?'#00A878':'#D62828'), line:{color:'#fff',width:1}},
  text:qs.map(x=>x.delta<0?'  '+pp(x.delta):pp(x.delta)), textposition:'outside',
    textangle:0,
    cliponaxis:false,
  customdata:qs.map(x=>[x.term1,x.term2,x.relative]),
  hovertemplate:'%{y}<br>الأول: %{customdata[0]:.1f}%<br>الثاني: %{customdata[1]:.1f}%<br>الفرق: %{x:.1f} نقطة<br>نسبة التحسن: %{customdata[2]:.1f}%<extra></extra>'
}], {...baseLayout, height:720, margin:{t:20,r:110,b:45,l:420}, xaxis:{title:'فرق النقاط المئوية', zeroline:true, zerolinecolor:'#073B4C', gridcolor:'#E8F0EE'}, yaxis:{automargin:true}}, cfg);

function metricBox(x){
  return `<div class="compare-mini">
    <div class="mini"><span>الفصل الأول</span><b>${pct(x.term1)}</b></div>
    <div class="mini"><span>الفصل الثاني</span><b>${pct(x.term2)}</b></div>
    <div class="mini"><span>مقدار التحسن</span><b class="${cls(x.delta)}">${pp(x.delta)}</b></div>
    <div class="mini"><span>نسبة التحسن</span><b class="${cls(x.delta)}">${rel(x.relative)}</b></div>
    <div class="mini"><span>الحالة</span><b class="${cls(x.delta)}">${x.trend}</b></div>
  </div>`;
}
document.getElementById('bestTitle').textContent = 'سؤال ' + DATA.overall.best.id;
document.getElementById('bestBox').innerHTML = `<div class="q-title" style="margin-bottom:12px">${DATA.overall.best.question}</div>` + metricBox(DATA.overall.best);
document.getElementById('worstTitle').textContent = 'سؤال ' + DATA.overall.worst.id;
document.getElementById('worstBox').innerHTML = `<div class="q-title" style="margin-bottom:12px">${DATA.overall.worst.question}</div>` + metricBox(DATA.overall.worst);

const tableRows = DATA.comparison.filter(x=>![1,2,3].includes(x.id)).map(x=>`
<tr>
<td>${String(x.id).padStart(2,'0')}</td>
<td>${x.question}</td>
<td>${pct(x.term1)}</td>
<td>${pct(x.term2)}</td>
<td><span class="pill ${cls(x.delta)}">${pp(x.delta)}</span></td>
<td><span class="pill ${cls(x.delta)}">${rel(x.relative)}</span></td>
<td><span class="pill ${cls(x.delta)}">${x.delta===null?'وصفي':x.trend}</span></td>
<td>${x.responses1?ar(x.responses1):'—'} / ${x.responses2?ar(x.responses2):'—'}</td>
</tr>`).join('');
document.getElementById('compareTable').innerHTML = `<thead><tr><th>#</th><th>السؤال</th><th>الفصل الأول</th><th>الفصل الثاني</th><th>مقدار التحسن</th><th>نسبة التحسن</th><th>الحالة</th><th>الاستجابات 1 / 2</th></tr></thead><tbody>${tableRows}</tbody>`;

const cards = document.getElementById('questionCards');
DATA.comparison.filter(x=>x.delta!==null).forEach(x=>{
  const card = document.createElement('article');
  card.className = 'card';
  card.innerHTML = `<div class="card-head"><div class="q-title">${x.question}</div><div class="q-id">${String(x.id).padStart(2,'0')}</div></div>
  <div id="mini_${x.id}" style="height:260px;padding:8px"></div>${metricBox(x)}`;
  cards.appendChild(card);
  Plotly.newPlot('mini_'+x.id, [{
    type:'bar', x:['الأول','الثاني'], y:[x.term1,x.term2],
    marker:{color:['#1C78A8','#00A19A'], line:{color:'#fff',width:1.5}},
    text:[pct(x.term1),pct(x.term2)], textposition:'outside',
    hovertemplate:'%{x}<br>%{y:.1f}%<extra></extra>'
  }], {...baseLayout, height:260, margin:{t:20,r:20,b:35,l:35}, yaxis:{range:[0,100],ticksuffix:'%',gridcolor:'#E8F0EE'}, showlegend:false}, cfg);
});
window.addEventListener('resize',()=>document.querySelectorAll('.js-plotly-plot').forEach(el=>Plotly.Plots.resize(el)));
</script>
</body>
</html>
